<idea-plugin>
    <id>local.claudechat</id>
    <name>Tether for Claude Code</name>
    <vendor>local</vendor>
    <description><![CDATA[
    Native chat panel for the Claude Code CLI. Runs the locally installed <code>claude</code>
    binary with your existing login, links files Claude touches, shows diffs of its edits,
    and tells Claude about files you edited between turns.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>com.intellij.modules.vcs</depends>
    <!-- TypeScript service errors for the diagnostics tool; the plugin works without it. -->
    <depends optional="true" config-file="tether-javascript.xml">JavaScript</depends>
    <!-- "Send Failures to Tether" in the test runner. -->
    <depends optional="true" config-file="tether-tests.xml">intellij.testRunner.plugin</depends>

    <extensionPoints>
        <extensionPoint qualifiedName="local.claudechat.problemSource" interface="claudechat.ide.tools.ProblemSource" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools" id="claudechat.settings" displayName="Tether"
                                 instance="claudechat.settings.ClaudeChatConfigurable"/>
        <toolWindow id="Tether" anchor="right" icon="/icons/tether.svg"
                    canCloseContents="true" factoryClass="claudechat.ui.ChatToolWindowFactory"/>
        <notificationGroup id="Tether" displayType="STICKY_BALLOON"/>
        <intentionAction>
            <language/>
            <className>claudechat.ide.FixWithTether</className>
            <category>Tether</category>
        </intentionAction>
    </extensions>

    <actions>
        <action id="claudechat.AddToChat" class="claudechat.ide.AddToChatAction"
                text="Add to Tether" description="Insert a reference to this file or selection into the Tether chat">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift alt K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift alt K"/>
        </action>
        <action id="claudechat.SendConsoleToTether" class="claudechat.ide.SendConsoleToTether"
                text="Send to Tether" description="Put the selected console output (or all of it) into the Tether chat">
            <add-to-group group-id="ConsoleView.PopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
